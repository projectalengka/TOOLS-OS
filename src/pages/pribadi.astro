---
/**
 * Ruang Pribadi.
 *
 * Halaman ini sengaja TIDAK ada di sidebar mana pun. Cara membukanya:
 *   1. Ketik langsung alamat /pribadi (paling praktis — simpan di bookmark)
 *   2. Klik tulisan "PERSONAL OS" di sidebar sebanyak 5 kali berturut-turut
 *
 * Membukanya tetap memerlukan master password.
 */
import AppLayout from '../layouts/AppLayout.astro';
import { icon } from '../lib/ui';
---

<AppLayout title="Ruang Pribadi" description="Area tersembunyi.">
  <div class="page" id="private-page">
    <header class="page-head">
      <div>
        <h1 class="page-title">
          <Fragment set:html={icon('vault', 20)} />
          <span>Ruang Pribadi</span>
        </h1>
        <p class="page-sub">
          Hanya kamu yang bisa membuka halaman ini. Isinya tidak muncul di daftar, pencarian, maupun statistik mana pun.
        </p>
      </div>
      <div class="page-actions">
        <a class="btn btn-outline" href="/">
          <Fragment set:html={icon('arrowLeft', 16)} />
          <span>Kembali</span>
        </a>
        <button type="button" class="btn btn-primary" id="pv-lock">
          <Fragment set:html={icon('lock', 16)} />
          <span>Kunci Sekarang</span>
        </button>
      </div>
    </header>

    <div class="vault-banner">
      <Fragment set:html={icon('shield', 16)} />
      <span>
        Isi Ruang Pribadi <strong>disembunyikan dan dikunci</strong>, tetapi <strong>tidak dienkripsi</strong> —
        berbeda dari password di halaman Accounts yang benar-benar terenkripsi. Yang melindunginya: login akunmu,
        Row Level Security, filter <code>hidden</code> di semua daftar dan pencarian, serta master password untuk
        membuka halaman ini. Halaman ini juga tidak pernah ditautkan di navigasi mana pun.
      </span>
    </div>

    <div class="toolbar">
      <div class="toolbar-search">
        <Fragment set:html={icon('search', 16)} />
        <input
          type="search"
          class="input"
          id="pv-search"
          placeholder="Cari di Ruang Pribadi…"
          aria-label="Cari di Ruang Pribadi"
          autocomplete="off"
        />
      </div>
      <div class="tabs" id="pv-tabs"></div>
    </div>

    <div id="pv-list"></div>
  </div>

  <script>
    import { initPrivatePage } from '../lib/pages/private';
    void initPrivatePage();
  </script>
</AppLayout>
